   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import tensorflow as tf\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import Dense\n",
    "\n",
    "# 1. Loading Dataset\n",
    "df = pd.read_csv('ANN_health_dataset.csv')\n",
    "\n",
    "\n",
    "# 2. Prepare Input and Output\n",
    "X = df[['Diet_Score', 'Exercise_Hours',\n",
    "        'Sleep_Hours', 'Stress_Level']].values\n",
    "y = df['Weight_Lost'].values\n",
    "\n",
    "#3.Build ANN\n",
    "model = Sequential([\n",
    "    tf.keras.Input(shape=(4,)),\n",
    "    Dense(8, activation='relu'),\n",
    "    Dense(8, activation='relu'),\n",
    "    Dense(4, activation='relu'),\n",
    "    Dense(4, activation='relu'),\n",
    "    Dense(1, activation='sigmoid')\n",
    "])\n",
    "\n",
    "\n",
    "# 4. Compile Model\n",
    "model.compile(\n",
    "    optimizer='adam',\n",
    "    loss='binary_crossentropy',\n",
    "    metrics=['accuracy']\n",
    ")\n",
    "\n",
    "model.fit(X, y, epochs=200, verbose=0)\n",
    "\n",
    "loss, accuracy = model.evaluate(X, y, verbose=1)\n",
    "print(\"Accuracy\",format(accuracy * 100))\n",
    "\n",
    "predictions = model.predict(X, verbose=0)\n",
    "\n",
    "df['Predictions'] = (predictions >= 0.5).astype(int)\n",
    "\n",
    "print(\"\\n--- Enter Lifestyle Details ---\")\n",
    "\n",
    "diet = float(input(\"Diet Score (1-10): \"))\n",
    "exc = float(input(\"Exercise Hours: \"))\n",
    "sleep = float(input(\"Sleep Hours: \"))\n",
    "stress = float(input(\"Stress Level (1-10): \"))\n",
    "\n",
    "user_data = np.array([[diet, exc, sleep, stress]])\n",
    "\n",
    "prediction = model.predict(user_data, verbose=0)[0][0]\n",
    "\n",
    "#print(\"\\nPrediction:\")\n",
    "\n",
    "if prediction >= 0.5:\n",
    "    print(\"Likely to Achieve Weight Loss\")\n",
    "else:\n",
    "    print(\"Unlikely to Achieve Weight Loss\")\n",
    "\n",
    "\n",
    "\n",
